SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Dominio público (ngrok, Tailscale Funnel o propio). Repetir el mismo host, con esquema,
# en CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=padel.duckdns.org
CSRF_TRUSTED_ORIGINS=https://padel.duckdns.org
DATABASE_URL=postgres://padel:change-me@db:5432/padel
DB_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong

# Email saliente (opcional). Sin EMAIL_HOST, los mails se imprimen en la consola
# del servicio (journalctl -u padel-torneos) y no se envía nada. Con Gmail:
# EMAIL_HOST=smtp.gmail.com y una «contraseña de aplicación» de la cuenta.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pádel Server <no-reply@padel.local>

# Aviso de nuevas solicitudes de registro (opcional):
# - Por email: los administradores generales con email ya reciben siempre;
#   SIGNUP_ALERT_EMAIL agrega una dirección extra.
# - Por WhatsApp (CallMeBot): guardar el contacto +34 644 51 95 23 en WhatsApp,
#   mandarle "I allow callmebot to send me messages" y anotar la apikey.
SIGNUP_ALERT_EMAIL=
WHATSAPP_ALERT_PHONE=
WHATSAPP_ALERT_APIKEY=
