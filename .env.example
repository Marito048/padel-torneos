SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Dominio público (ngrok, Tailscale Funnel o propio). Repetir el mismo host, con esquema,
# en CSRF_TRUSTED_ORIGINS.
ALLOWED_HOSTS=padel.duckdns.org
CSRF_TRUSTED_ORIGINS=https://padel.duckdns.org
# Proxies de confianza para leer X-Forwarded-For (IPs o CIDR separados por coma).
# Dejar vacío con Tailscale Funnel/ngrok: no entregan la IP real del visitante y
# el header lo puede falsificar el cliente.
TRUSTED_PROXY_IPS=
# Cuotas anti-abuso de reservas públicas por teléfono (respaldadas en la base).
PUBLIC_RESERVATION_MAX_ACTIVE=3
PUBLIC_RESERVATION_MAX_PER_HOUR=10
# Límite por sesión de la solicitud pública de cuenta (caché local del worker).
SIGNUP_REQUEST_MAX_PER_WINDOW=10
SIGNUP_REQUEST_WINDOW_SECONDS=900
# Límite por sesión de consultas/acciones con código de turno (caché local).
# Frena bucles y fuerza bruta oportunista; rotar cookies lo evade.
PUBLIC_CODE_MAX_PER_WINDOW=60
PUBLIC_CODE_WINDOW_SECONDS=300
DATABASE_URL=postgres://padel:change-me@db:5432/padel
DB_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong

# Email saliente (opcional). Sin EMAIL_HOST, los mails se imprimen en la consola
# del servicio (journalctl -u padel-torneos) y no se envía nada. Con Gmail:
# EMAIL_HOST=smtp.gmail.com y una «contraseña de aplicación» de la cuenta.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Pádel Server <no-reply@padel.local>

# Aviso de nuevas solicitudes de registro (opcional):
# - Por email: los administradores generales con email ya reciben siempre;
#   SIGNUP_ALERT_EMAIL agrega una dirección extra.
# - Por WhatsApp (CallMeBot): guardar el contacto +34 644 51 95 23 en WhatsApp,
#   mandarle "I allow callmebot to send me messages" y anotar la apikey.
SIGNUP_ALERT_EMAIL=
WHATSAPP_ALERT_PHONE=
WHATSAPP_ALERT_APIKEY=

# Cobro online de la seña de turnos (Mercado Pago Checkout Pro).
# Primera versión: deshabilitado. Los complejos cobran manualmente desde el
# panel; no se crean preferencias ni se procesan webhooks. En producción queda
# forzado a false aunque esta variable diga true.
MERCADO_PAGO_ONLINE_PAYMENTS_ENABLED=false
# El access token se carga por complejo en «Turnos → Precio y avisos»; no va
# en este archivo. La seña es un porcentaje del precio del turno y el saldo se
# paga en el club. La retención es el tiempo que se guarda el horario sin pagar.
BOOKING_DEPOSIT_PERCENT=30
BOOKING_HOLD_MINUTES=15
MERCADO_PAGO_TIMEOUT=15
# Moneda del checkout y de los pagos aceptados.
MERCADO_PAGO_CURRENCY=ARS
# Si un complejo carga un token, también debe cargar el secreto de firma del
# webhook. Con true, sin secreto no se crea el checkout y el webhook responde
# 503 en vez de procesar notificaciones sin autenticar. En producción queda
# forzado a true; los complejos sin token no se ven afectados.
MERCADO_PAGO_REQUIRE_WEBHOOK_SECRET=true
